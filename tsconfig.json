{
    // Solo chequeo de tipos: el código lo ejecuta Node 24 directamente (type stripping), tsc no emite nada
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "strict": false,
        "types": ["node"],
        // Los tipos de mongoose-paginate-v2 todavía usan FilterQuery, que Mongoose 9 renombró
        "skipLibCheck": true
    },
    "include": ["server.ts", "src/**/*.ts"]
}
